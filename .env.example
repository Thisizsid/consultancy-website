# Node.js Backend
VITE_API_URL=http://localhost:5000/api

# Server Config (used by server/index.js)
PORT=5000
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@lassoconsultancy.com
ADMIN_PASSWORD=your_admin_password_here

# Frontend URL (used in password reset email link)
FRONTEND_URL=http://localhost:5173

# SMTP Email Config (for password reset emails)
# Use Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password

# Notification Recipient Email for Password Resets
NOTIFICATION_EMAIL=lassoconsultancy4@gmail.com