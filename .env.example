# Node.js Backend
VITE_API_URL=http://localhost:5000/api

# Google Analytics 4 Measurement ID — not a secret, safe to ship in the
# frontend bundle. Leave unset locally; analytics only load when present
# (see src/utils/analytics.js).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server Config (used by server/index.js)
PORT=5000
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@lassoconsultancy.com
ADMIN_PASSWORD=your_admin_password_here

# Frontend URL (used in password reset email link)
FRONTEND_URL=http://localhost:5173

# Resend (for password reset emails) — https://resend.com, free tier is
# 100 emails/day. RESEND_FROM_EMAIL is optional; without it, sends use
# Resend's default onboarding@resend.dev sender, which needs no domain
# verification. Set your own only once a domain is verified in Resend.
RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=Lasso Consultancy <noreply@yourdomain.com>

# Notification Recipient Email for Password Resets
NOTIFICATION_EMAIL=lassoconsultancy4@gmail.com