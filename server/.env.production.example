# Production environment for the Node backend.
# Copy to the project root as .env on the production host and fill in real values.
# The server loads the ROOT .env (one level above server/), not this file.

NODE_ENV=production
PORT=5000

# Absolute path to a persistent volume/disk. database.sqlite and uploads/
# are written here instead of next to the source, so they survive redeploys
# on platforms with an ephemeral filesystem (e.g. Railway — mount a volume
# and set this to its mount path, such as /data). Leave unset to use the
# default (next to the server source — fine for a plain VPS with a
# persistent disk, but NOT fine on Railway/Render/etc without a volume).
DATA_DIR=

# Long random value. Generate with:  openssl rand -hex 48
JWT_SECRET=

# Initial admin account. Only used to seed the very first admin; after that,
# change the password from the CMS or via server/scripts/reset-admin-password.js
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL — used to build password reset links in emails.
# MUST be the real domain, never localhost, or reset links will be unusable.
FRONTEND_URL=https://lassoconsultancy.com

# Where password reset emails are delivered
NOTIFICATION_EMAIL=lassoconsultancy4@gmail.com

# Resend (https://resend.com) — not SMTP. Most PaaS platforms (Railway
# included) block or badly throttle outbound SMTP, which made password
# resets fail unpredictably. Resend sends over plain HTTPS instead.
# Free tier: 100 emails/day, no domain verification required.
RESEND_API_KEY=
# Optional — defaults to Resend's onboarding@resend.dev sender, which needs
# no verification. Only set this once a sending domain is verified in Resend.
# RESEND_FROM_EMAIL=Lasso Consultancy <noreply@lassoconsultancy.com>
